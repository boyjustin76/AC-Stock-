[
 {
  "i": 0,
  "sec": "INTRO",
  "text": "밴드 하단에 샀는데 왜 계속 빠질까요?",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 1,
  "sec": "INTRO",
  "text": "볼린저밴드 하단에 닿아서 매수했는데, 가격이 하단 밴드를 타고 계속 내려간 경험 있으시죠?",
  "score": 0.787,
  "s": 17.6,
  "e": 21.62,
  "takes": 1
 },
 {
  "i": 2,
  "sec": "INTRO",
  "text": "대부분의 경우,",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 3,
  "sec": "INTRO",
  "text": "우리가 한 번만 확인하고 너무 빨리 들어간 겁니다.",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 4,
  "sec": "INTRO",
  "text": "볼린저밴드의 상단과 하단은 매수·매도를 확정하는 선이 아니라,",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 5,
  "sec": "INTRO",
  "text": "가격이 평소 범위에서 얼마나 멀어졌는지를 보여주는 기준입니다.",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 6,
  "sec": "INTRO",
  "text": "그래서 오늘은 볼린저밴드를 하나 더 겹쳐서 사용하는 매매법을 보여드릴텐데요,",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 7,
  "sec": "INTRO",
  "text": "설정은 딱 두 개뿐이고, 진입 순서도 간단합니다.",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 8,
  "sec": "INTRO",
  "text": "초보자도 쉽고 간단하게 적용하여 사용할 수 있는단순하면서 강력한 매매법!",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 9,
  "sec": "INTRO",
  "text": "지금부터 소개해 드리겠습니다.",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 10,
  "sec": "1장",
  "text": "단일 볼린저밴드가 자꾸 속이는 이유",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 11,
  "sec": "1장",
  "text": "먼저 볼린저밴드가 무엇을 보여주는 지표인지부터 짚어보겠습니다.",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 12,
  "sec": "1장",
  "text": "볼린저밴드는 이동평균선을 중심으로 가격의 표준편차를 위아래에 표시한 변동성 지표입니다.",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 13,
  "sec": "1장",
  "text": "가격 변동이 작을 때는 밴드가 좁아지고, 변동이 커지면 밴드도 넓어집니다.",
  "score": 1.0,
  "s": 88.94,
  "e": 95.64,
  "takes": 2
 },
 {
  "i": 14,
  "sec": "1장",
  "text": "일반적으로 많이 사용하는 설정은 기간 20 또는 21에 편차 2입니다.",
  "score": 0.966,
  "s": 95.64,
  "e": 101.56,
  "takes": 1
 },
 {
  "i": 15,
  "sec": "1장",
  "text": "이번 영상에서는 기간 21, 편차 2로 통일하겠습니다.",
  "score": 1.0,
  "s": 101.56,
  "e": 105.86,
  "takes": 1
 },
 {
  "i": 16,
  "sec": "1장",
  "text": "아마도 많은 분들이 상단 밴드에 닿으면 과열이니까 매도하고,",
  "score": 1.0,
  "s": 105.86,
  "e": 110.34,
  "takes": 1
 },
 {
  "i": 17,
  "sec": "1장",
  "text": "하단 밴드에 닿으면 과매도니까 매수합니다.",
  "score": 1.0,
  "s": 110.34,
  "e": 113.28,
  "takes": 4
 },
 {
  "i": 18,
  "sec": "1장",
  "text": "지금 보고 계신 이러한 횡보장에서는 이 방법이 꽤 잘 맞아 보입니다.",
  "score": 1.0,
  "s": 113.98,
  "e": 119.62,
  "takes": 1
 },
 {
  "i": 19,
  "sec": "1장",
  "text": "가격이 상단과 하단 사이를 오가기 때문에 상단 매도와 하단 매수가 연속해서 성공하는 구간이 나오는 것을 알 수 있죠.",
  "score": 1.0,
  "s": 119.72,
  "e": 128.02,
  "takes": 1
 },
 {
  "i": 20,
  "sec": "1장",
  "text": "하지만 진짜 문제는 시장에 추세 방향이 생겼을 때입니다.",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 21,
  "sec": "1장",
  "text": "강한 상승에서는 가격이 상단 밴드를 따라 계속 오르고,",
  "score": 0.878,
  "s": 266.8,
  "e": 271.5,
  "takes": 2
 },
 {
  "i": 22,
  "sec": "1장",
  "text": "강한 하락에서는 하단 밴드를 따라 계속 밀릴 수 있습니다.",
  "score": 1.0,
  "s": 271.5,
  "e": 276.06,
  "takes": 1
 },
 {
  "i": 23,
  "sec": "1장",
  "text": "이걸 흔히 밴드 타기 현상이라고 합니다.",
  "score": 1.0,
  "s": 276.06,
  "e": 279.06,
  "takes": 1
 },
 {
  "i": 24,
  "sec": "1장",
  "text": "밴드타기 현상이 일어나고 있는 구간에서",
  "score": 1.0,
  "s": 279.06,
  "e": 282.12,
  "takes": 1
 },
 {
  "i": 25,
  "sec": "1장",
  "text": "상단에 닿았다는 이유로 계속 매도하거나,",
  "score": 1.0,
  "s": 282.12,
  "e": 285.26,
  "takes": 4
 },
 {
  "i": 26,
  "sec": "1장",
  "text": "하단에 닿았다는 이유로 계속 매수하면 추세와 정면으로 부딪히게 됩니다.",
  "score": 1.0,
  "s": 285.26,
  "e": 291.38,
  "takes": 1
 },
 {
  "i": 27,
  "sec": "1장",
  "text": "이로써 우리는 밴드 접촉의 의미가 신호등의 빨간불이나 초록불처럼 바로 실행하는 신호가 아니라는 것을 알 수 있습니다.",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 28,
  "sec": "1장",
  "text": "밴드에 닿았다는 개념을",
  "score": 0.667,
  "s": 24.72,
  "e": 26.44,
  "takes": 2
 },
 {
  "i": 29,
  "sec": "1장",
  "text": "‘평소 범위의 끝에 가까워졌으니 이제부터 확인이 필요하다’는 주의를 주는 신호에 가깝다고 생각하셔야 합니다.",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 30,
  "sec": "1장",
  "text": "그렇다면 첫 번째 주의를 주는 신호 다음에는 무엇을 확인해야 할까요?",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 31,
  "sec": "1장",
  "text": "바로 여기서 볼린저밴드를 하나 더 사용합니다.",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 32,
  "sec": "2장",
  "text": "더블 볼린저밴드 설정은 두 개만 기억합니다",
  "score": null,
  "s": null,
  "e": null,
  "takes": 0
 },
 {
  "i": 33,
  "sec": "2장",
  "text": "첫 번째는 방금 보신 기본 볼린저밴드를 불러오겠습니다.",
  "score": 0.913,
  "s": 400.24,
  "e": 404.42,
  "takes": 1
 },
 {
  "i": 34,
  "sec": "2장",
  "text": "기간은 21, 편차는 2, 적용 가격은 종가로 설정합니다.",
  "score": 1.0,
  "s": 405.38,
  "e": 410.5,
  "takes": 2
 },
 {
  "i": 35,
  "sec": "2장",
  "text": "이 밴드는 시장의 기본 범위와 중심 방향을 확인하는 역할을 합니다.",
  "score": 1.0,
  "s": 410.5,
  "e": 415.72,
  "takes": 1
 },
 {
  "i": 36,
  "sec": "2장",
  "text": "이후 설명에서는 메인밴드라고 부르겠습니다.",
  "score": 1.0,
  "s": 415.72,
  "e": 419.32,
  "takes": 2
 },
 {
  "i": 37,
  "sec": "2장",
  "text": "두 번째로 볼린저밴드를 하나 더 추가하겠습니다.",
